/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for assembly metadata pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

plugins {
    id 'nf-schema@2.4.2'
}

validation {
    help {
        enabled = true
    }
}

params {

    // Default options
    taxon = 2759
    ncbi_url = "https://api.ncbi.nlm.nih.gov/datasets/v2"

    // Path to data files
    ncbi_params    = "$projectDir/data/ncbi_params.json"
    db_table_conf  = "$projectDir/data/db_table_conf.json"
    metadata_params = "$projectDir/data/metadata_params.json"

    // Input options
    output_dir  = null
    enscode     = null
    full_screen = false
    add_gca     = false
    gca_list    = null
    date        = null  // format: MM/DD/YYYY (optional)

}

profiles {
    standard {
        executor {
            name             = 'slurm'
            queueSize        = 2000
            submitRateLimit  = "10/1sec"
            queueGlobalStatus = true
            exitReadTimeout  = "30 min"
        }
        process {
            clusterOptions = '-e errlog.txt'
        }
    }
}

process {
    cpus   = 1
    memory = '500 MB'
    time   = '60 min'

    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'python' {
        maxForks  = 10
        memory    = { 1.GB * task.attempt }
        time      = { 4.h * task.attempt }
        module    = 'singularity-3.7.0-gcc-11.2.0-dtj2md2'
        container = 'community.wave.seqera.io/library/pip_pymysql_requests_tenacity:88dac79b69f40303'
    }
}
